{
  "manifest_version": 3,
  "name": "Reseller Assistant",
  "version": "0.7.0.2",
  "description": "Fill Mercari and Poshmark sell forms from Reseller Assistant. You still press Publish.",
  "homepage_url": "https://reseller.mvfeed.us",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "sidePanel", "scripting"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://reseller.mvfeed.us/*",
    "https://reseller-assistant.vercel.app/*",
    "https://*.mercari.com/*",
    "https://www.mercari.com/*",
    "https://poshmark.com/*",
    "https://www.poshmark.com/*",
    "https://*.poshmark.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Reseller Assistant",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://reseller.mvfeed.us/*",
        "https://reseller-assistant.vercel.app/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.mercari.com/*",
        "https://www.mercari.com/*",
        "https://poshmark.com/*",
        "https://www.poshmark.com/*",
        "https://*.poshmark.com/*"
      ],
      "js": ["coach-shared.js", "closet-sync.js", "content.js", "page-coach.js"],
      "run_at": "document_idle"
    }
  ]
}
