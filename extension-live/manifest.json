{
  "manifest_version": 3,
  "name": "Reseller Assistant",
  "version": "0.3.0",
  "description": "Autofill Mercari and Poshmark listing pages from Reseller Assistant.",
  "permissions": ["storage", "activeTab", "sidePanel", "tabs"],
  "host_permissions": [
    "http://localhost/*",
    "http://localhost:3000/*",
    "http://127.0.0.1/*",
    "http://127.0.0.1:3000/*",
    "https://reseller.mvfeed.us/*",
    "https://reseller-assistant.vercel.app/*",
    "https://*.vercel.app/*",
    "https://*.mercari.com/*",
    "https://poshmark.com/*",
    "https://*.poshmark.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Reseller Assistant"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://localhost:3000/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:3000/*",
        "https://reseller.mvfeed.us/*",
        "https://reseller-assistant.vercel.app/*",
        "https://*.vercel.app/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.mercari.com/*/sell*",
        "https://*.mercari.com/*/create*",
        "https://*.mercari.com/*/list*",
        "https://*.mercari.com/sell*",
        "https://poshmark.com/*/create*",
        "https://poshmark.com/*/list*",
        "https://poshmark.com/*/sell*",
        "https://*.poshmark.com/*/create*",
        "https://*.poshmark.com/*/list*",
        "https://*.poshmark.com/*/sell*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
