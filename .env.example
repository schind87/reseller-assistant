# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://gcmbimhkpcilnccrkzlj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: signs temporary QR join cookies for phone photo sessions
SESSION_SECRET=replace-with-a-long-random-string

# App URL (QR codes + extension pairing + auth redirects)
NEXT_PUBLIC_APP_URL=https://reseller.mvfeed.us

# Resend (auth emails via Send Email hook)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Reseller Assistant <noreply@mvfeed.us>
SEND_EMAIL_HOOK_SECRET=v1,whsec_xxxxxxxx

# Optional AI (features degrade gracefully when missing)
# Prefer OpenRouter (one key for Gemini / OpenAI / Claude). Falls back to OPENAI_API_KEY.
OPENROUTER_API_KEY=
# Optional model overrides (OpenRouter model IDs)
OPENROUTER_IDENTIFY_MODEL=google/gemini-2.5-pro
OPENROUTER_DRAFT_MODEL=openai/gpt-4o
OPENAI_API_KEY=
# fal.ai — used for Pixelcut product photos / BiRefNet fallback
# https://fal.ai/dashboard/keys
FAL_KEY=
# Comma-separated emails allowed to open /app/admin/* (background model lab)
ADMIN_EMAILS=
