# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://gcmbimhkpcilnccrkzlj.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Required in production. Signs seller session JWTs (ra_session, ~30 days)
# and QR phone-join cookies (ra_join). Keep this value stable — changing it
# signs out every user immediately. Do not reuse the Supabase anon key.
SESSION_SECRET=replace-with-a-long-random-string

# Canonical production URL for QR/join links and auth redirects.
# Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=https://reseller.mvfeed.us

# Resend (auth emails via Send Email hook)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Reseller Assistant <noreply@mvfeed.us>
SEND_EMAIL_HOOK_SECRET=v1,whsec_xxxxxxxx

# Optional AI (features degrade gracefully when missing)
# Prefer OpenRouter (one key for Gemini / OpenAI / Claude). Falls back to OPENAI_API_KEY.
OPENROUTER_API_KEY=
# Optional model overrides (OpenRouter model IDs)
OPENROUTER_IDENTIFY_MODEL=google/gemini-2.5-pro
OPENROUTER_DRAFT_MODEL=openai/gpt-4o
OPENAI_API_KEY=
# fal.ai — used for Pixelcut product photos / BiRefNet fallback / AI Photo Lab
# https://fal.ai/dashboard/keys
# Inference works with a normal API key. Actual per-request costs need an
# ADMIN-scoped key (create one with Admin scope, or set FAL_ADMIN_KEY).
FAL_KEY=
FAL_ADMIN_KEY=
# Comma-separated emails allowed to open /app/admin/* (AI Photo Lab, Users)
ADMIN_EMAILS=

# Cloudflare R2 — listing photos (private bucket + presigned GET).
# When unset, photos stay in the local/hosted Supabase `listing-photos` bucket.
# Create a Standard R2 bucket (not Infrequent Access) and an S3 API token:
# https://developers.cloudflare.com/r2/api/s3/tokens/
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=listing-photos
# Optional. Defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=
